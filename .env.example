# Copy to .env and adjust. See README.md for how to set up the local
# admin account this container logs in with.

# --- Required ---
UCG_HOST=192.168.1.1
UCG_USERNAME=backup-bot
UCG_PASSWORD=change-me

# --- Optional (defaults shown) ---
UCG_SITE=default
# UniFi OS consoles use a self-signed certificate by default, so TLS
# verification is off unless you've installed a trusted certificate.
VERIFY_SSL=false
CRON_SCHEDULE=0 3 * * *
RETENTION_DAYS=30
RUN_ON_START=true
NOTIFY_ON_SUCCESS=false
TZ=UTC

# Plain-text POST notification on backup failure (and success, if enabled
# above). Works out of the box with ntfy.sh or Healthchecks.io ping URLs.
# WEBHOOK_URL=https://ntfy.sh/my-ucg-backups
