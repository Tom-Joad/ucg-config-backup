# Copy to .env and fill in. .env is git-ignored; never commit it.
UCG_HOST=192.168.1.1
UCG_USERNAME=backup-bot
UCG_PASSWORD=change-me
# Optional, usually carries a secret in its path.
WEBHOOK_URL=

# The user the backups belong to and the time zone of the schedule. Unraid:
# PUID=99, PGID=100, UMASK=002.
# PUID=1000
# PGID=1000
# UMASK=022
# TZ=Etc/UTC

# Optional settings, shown with their defaults.
# UCG_SITE=default
# NETWORK_BACKUP=true
# SYSTEM_BACKUP=true
# VERIFY_SSL=false
# CRON_SCHEDULE=0 3 * * *
# RETENTION_DAYS=30
# RUN_TIMEOUT=1800
# LOG_LEVEL=INFO
# SHA-256 fingerprint of the console certificate; pins it (see the README).
# UCG_CERT_SHA256=
# RUN_ON_START=true
# NOTIFY_ON_SUCCESS=false
# WEBHOOK_FORMAT=text

# A second console (or more: _3, _4, ...). Its settings end in _2; console 1
# keeps the names without a suffix. Nothing is taken over from console 1, so
# set what differs from the defaults again. Its backups go to the folder
# UCG_NAME_2 below /backups (default console-2).
# UCG_HOST_2=192.168.1.2
# UCG_USERNAME_2=backup-bot
# UCG_PASSWORD_2=change-me
# UCG_NAME_2=nvr
# NETWORK_BACKUP_2=false
# Also per console: UCG_SITE_2, SYSTEM_BACKUP_2, VERIFY_SSL_2, UCG_CERT_SHA256_2.
# Console 1 gets a folder of its own only with a name:
# UCG_NAME=gateway
