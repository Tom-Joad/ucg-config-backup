# Copy to .env and fill in. .env is git-ignored; never commit it.
UCG_HOST=192.168.1.1
UCG_USERNAME=backup-bot
UCG_PASSWORD=change-me
# Optional, usually carries a secret in its path.
WEBHOOK_URL=

# The user the backups belong to and the time zone of the schedule. Unraid:
# PUID=99, PGID=100, UMASK=002.
# PUID=1000
# PGID=1000
# UMASK=022
# TZ=Etc/UTC

# Optional settings, shown with their defaults.
# UCG_SITE=default
# SYSTEM_BACKUP=true
# VERIFY_SSL=false
# CRON_SCHEDULE=0 3 * * *
# RETENTION_DAYS=30
# RUN_ON_START=true
# NOTIFY_ON_SUCCESS=false
# WEBHOOK_FORMAT=text
