#!/usr/bin/with-contenv bash
# shellcheck shell=bash

# Runs once per container start and then stays down (s6-svc -O).
s6-svc -O .

# The init step has checked the value: true or false in any case, or empty.
run_on_start=${RUN_ON_START:-true}
run_on_start=${run_on_start//[[:space:]]/}
if [[ ${run_on_start,,} == true ]]; then
    echo "RUN_ON_START=true, running an initial backup now..."
    /usr/local/bin/ucg-backup || echo "Initial backup failed; will retry on the next scheduled run."
fi
