#!/usr/bin/with-contenv bash
# shellcheck shell=bash

# with-contenv puts the container environment (including the password, which
# never touches the file system) into this process. UMASK only applies to
# s6 services on its own, not to cron jobs.
umask "${UMASK:-022}"

# One backup at a time: the start-up run and a scheduled one, or a manual
# `docker exec`, must not log in to the console side by side. The lock is
# held on fd 9 through the exec below.
# The wrapper's own messages are JSON lines like backup.py's (standards/runtime.md).
log() { # level event [field=value ...]; values are plain text without quotes
    local level=$1 event=$2 tz fields="" pair
    shift 2
    tz=$(date +%z)
    if [[ ${tz} == +0000 ]]; then tz=Z; else tz="${tz:0:3}:${tz:3:2}"; fi
    for pair in "$@"; do
        if [[ ${pair#*=} =~ ^[0-9]+$ ]]; then
            fields+=",\"${pair%%=*}\":${pair#*=}"
        else
            fields+=",\"${pair%%=*}\":\"${pair#*=}\""
        fi
    done
    printf '{"ts":"%s.000%s","level":"%s","event":"%s"%s}\n' "$(date '+%Y-%m-%dT%H:%M:%S')" "${tz}" "${level}" "${event}" "${fields}"
}

LOCK=/tmp/ucg-backup.lock
SKIPS=/tmp/ucg-backup.skips
# Skipped runs in a row after which a failed webhook is sent: a run that
# hangs would otherwise block every later one without a word.
SKIPS_BEFORE_ALERT=3

# The lock belongs to root. `docker exec -u abc` can't open it, and must not
# be told that "a backup is already running".
if ! exec 9>>"${LOCK}"; then
    log ERROR lock_unavailable "user=$(id -un)" "error=cannot open ${LOCK}. Run this as root (docker exec without -u): it switches to PUID/PGID itself." >&2
    exit 1
fi

# Without root there is nobody to drop privileges from (and s6-setuidgid
# would fail): run as the current user.
run=(python3 /usr/local/bin/backup.py)
if [[ -z ${LSIO_NON_ROOT_USER:-} ]] && [[ $(id -u) == 0 ]]; then
    # s6-setuidgid keeps root's HOME=/root, which abc can't read. There is no
    # /config here; /tmp is always writable.
    export HOME=/tmp
    run=(s6-setuidgid abc "${run[@]}")
fi

if ! flock -n 9; then
    skips=$(cat "${SKIPS}" 2>/dev/null || true)
    [[ ${skips} =~ ^[0-9]+$ ]] || skips=0
    skips=$((skips + 1))
    log WARNING run_skipped "reason=a backup is already running, skipping this one" "skipped=${skips}"
    echo "${skips}" >"${SKIPS}"
    # Only the run that reaches the limit reports, not every one after it.
    if (( skips == SKIPS_BEFORE_ALERT )); then
        "${run[@]}" --skipped "${skips}" 9>&-
    fi
    exit 0
fi
rm -f "${SKIPS}"

# Backstop behind the run's own RUN_TIMEOUT (a stuck name lookup doesn't
# reach Python's signal handler): the lock goes with the process.
limit=${RUN_TIMEOUT:-1800}
[[ ${limit} =~ ^[0-9]+$ ]] || limit=1800 # a bad value is reported by backup.py
exec timeout -s KILL "$((limit + 120))" "${run[@]}" "$@"
